rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global fallback for all collections & documents in the database
    match /{document=**} {
      allow read, write: if true;
    }

    match /trackers/{trackerId} {
      allow read, write: if true;
    }
    match /folders/{folderId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /siteVisits/{visitId} {
      allow read, write: if true;
    }
    match /decks/{deckId} {
      allow read, write: if true;
    }
    match /changeRequests/{requestId} {
      allow read, write: if true;
    }
    match /meta/{docId} {
      allow read, write: if true;
    }
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
